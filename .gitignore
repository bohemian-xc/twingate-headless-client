# Standard files and folders to ignore
node_modules/
dist/
build/
.env
.env.local
.env.override
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
*.swp
*.swo
*.tmp
*.bak
.idea/
.vscode/
coverage/
*.tsbuildinfo

# Ignore all files and folders in the vol folder
vol/
vol/**
vol/logs/
vol/logs/**

# Ignore service key JSON file in the app folder
app/service-key/*.json

# Ignore host configuration files
host/*.json

# Ignore dev-container configuration files
.devcontainer/